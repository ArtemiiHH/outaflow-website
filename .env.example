# PUBLIC: only a public Storefront access token belongs in VITE_ variables.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Same-origin endpoint, implemented by api/newsletter.mjs on Vercel.
# Leave blank until the server integration is deployed and configured.
VITE_NEWSLETTER_ENDPOINT=
# Development only. Ignored in production builds, even when true.
VITE_PREVIEW_MODE=false

# SERVER ONLY. NEVER prefix these with VITE_.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
NEWSLETTER_ALLOWED_ORIGIN=https://your-domain.com
